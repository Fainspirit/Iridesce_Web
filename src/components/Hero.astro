---
import '../styles/main.css';
const name = "Startail";
const greeting = "Hello!";
---

<section class="hero landing-hero">
    <h1>Oh, hi!</h1>
    <p>This is my website for art, dev blogs, games, tools, and more!</p>

    <div class="big-buttons">        
        <a href="/games/" class="big-button">My Games</a>
        <a href="/d_and_d/" class="big-button">D&D</a>
        <a href="/gallery/" class="big-button">Art Gallery</a>
        <a href="/blog/" class="big-button">Dev Blog</a>
        <a href="/about/" class="big-button">About Me</a>
    </div>
    
</section>


<style>
/* Big Buttons */
.big-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-md);
    justify-content: center;
    margin-top: var(--spacing-xl);
}

.big-button {
    display: inline-block;
    padding: 1rem 2rem;
    background: linear-gradient(-135deg, gray, black, gray);
    color: white;
    font-size: 1.125rem;
    font-weight: 600;
    border-radius: 999px;
    text-decoration: none;
    transition: transform var(--transition-normal), box-shadow var(--transition-normal);
}

.big-button:hover {
    #transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(236, 72, 153, 0.3);
    color: black;
    font-weight: 600;
    background: linear-gradient(-135deg, yellow, pink, cyan, lime);
    transition: background-color 4s;
}
</style>