---
import '../styles/main.css';
const imageCount = 3;
---

<section class="gallery-section">
    <h2>Art Gallery</h2>
    <p>A collection of digital art and design work.</p>

    <div class="gallery-grid">
        {Array(imageCount).fill(null).map((_, i) => (
            <article class="gallery-item">
                <div class="placeholder">{`Gallery Image ${i + 1}`}</div>
            </article>
        ))}
    </div>

    <p><em>Add your images to showcase your work.</em></p>
</section>
