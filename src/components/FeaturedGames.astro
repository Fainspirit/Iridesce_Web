---
const games = [
    { title: "Fleurish", link: "https://fainspirit.itch.io/fleurish", desc: "Roguelike action RPG with flower upgrades" },
    { title: "Game and Shock", link: "https://fainspirit.itch.io/game-and-shock", desc: "Arcade game defending your monument" },
    { title: "Moonlight", link: "https://fainspirit.itch.io/moonlight", desc: "Action adventure about bad luck" },
    { title: "RGBee", link: "https://fainspirit.itch.io/rgbee", desc: "Puzzle game turning off colors" },
];
---

<section class="games-section">
    <h2>My Games</h2>
    <p>A collection of indie games on itch.io.</p>

    <div class="game-grid">
        {games.map((game) => (
            <a href={game.link} class="game-card" target="_blank" rel="noopener noreferrer">
                <span class="game-icon">🎮</span>
                <h3>{game.title}</h3>
                <p>{game.desc}</p>
            </a>
        ))}
    </div>
</section>

<section class="about-section">
    <h2>About</h2>
    <p>I'm a developer and creative maker. This website showcases my games, art gallery, and dev blog.</p>
</section>

<section class="contact-section">
    <h2>Connect</h2>
    <div class="social-links">
        <a href="https://fainspirit.itch.io" class="social-link">🔗 Itch.io</a>
        <a href="#" class="social-link">📧 Email Me</a>
    </div>
</section>

<footer class="footer">
    <p>&copy; 2026 Startail. Built with Astro.</p>
</footer>
