---
import '../styles/main.css';
const SITE_INFO = Astro.url;
export const title = 'Iridesce';
---

<header class="header">
    <a href="/" class="logo">Iridesce</a>
    <nav class="nav">
        <ul>
            <li><a href="/games/">Games</a></li>
            <li><a href="/mythos/">Mythos</a></li>
            <li><a href="/gallery/">Gallery</a></li>
            <li><a href="/blog/">Blog</a></li>
            <li><a href="/about/">About</a></li>
        </ul>
    </nav>
</header>

<style>
/* Header Container */
.header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--spacing-sm) var(--spacing-xl);
    
    /* Transparent or light background lets the watercolor texture show through */
    background: var(--color-bg); 
    border-bottom: 2px solid var(--color-accent);
}

/* Custom Properties for Iridescent Logo Shift */
@property --logo-col-1 { syntax: '<color>'; inherits: false; initial-value: #C59B27; }
@property --logo-col-2 { syntax: '<color>'; inherits: false; initial-value: #1B4332; }
@property --logo-col-3 { syntax: '<color>'; inherits: false; initial-value: #52796F; }

.logo {
    font-size: 3rem;
    font-weight: 500;
    font-family: var(--font-fleur-de-leah);
    display: inline-block;
    padding: 0.25em;
    text-decoration: none;

    /* Gold-to-Jade gradient text fill */
    background: linear-gradient(135deg, var(--logo-col-1), var(--logo-col-2), var(--logo-col-3));
    background-repeat: no-repeat;
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;

    /* Subtle single ink drop-shadow to separate script text from paper background */
    filter: drop-shadow(0 2px 4px rgba(30, 37, 36, 0.15));

    transition: 
        --logo-col-1 0.4s ease, 
        --logo-col-2 0.4s ease, 
        --logo-col-3 0.4s ease,
        transform 0.3s ease;
}

.logo:hover {
    --logo-col-1: #E5C158;
    --logo-col-2: #3E7C74;
    --logo-col-3: #C59B27;
    transform: scale(1.02);
}

/* Navigation */
.nav ul {
    display: flex;
    list-style: none;
    gap: var(--spacing-sm);
    margin: 0;
    padding: 0;
}

.nav a {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    letter-spacing: 0.05em; /* Slightly wider spacing elevates the luxury feel */

    font-weight: 600;
    color: var(--color-text); /* Dark Sumi Ink for clear readability on paper */
    text-decoration: none;
    padding: var(--spacing-sm) var(--spacing-md);
    position: relative;
    display: inline-block;
    transition: color var(--transition-fast), transform var(--transition-fast);
}

/* Clean Underline & Glow Accent on Hover */
.nav a::after {
    content: '';
    position: absolute;
    bottom: 4px;
    left: 50%;
    width: 0;
    height: 2px;
    background-color: var(--color-accent);
    transition: width var(--transition-fast) ease, left var(--transition-fast) ease;
    border-radius: 2px;
}

.nav a:hover {
    color: var(--color-primary); /* Deep Jade on hover */
}

.nav a:hover::after {
    width: 80%;
    left: 10%;
}
</style>