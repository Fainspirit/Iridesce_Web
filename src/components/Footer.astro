---
let year = new Date().getFullYear();
---

<footer class="footer">
    <p>&copy; {year} Fainspirit.</p>
</footer>

<style is:global>
    .footer {
        text-align: center;
        padding: var(--spacing-lg) var(--spacing-xl);
        background: var(--color-dark);
        color: white;
        font-size: 0.875rem;
        margin-top: auto;
        margin-bottom: auto;
    }

    .footer p {
        opacity: 0.8;
    }
</style>
