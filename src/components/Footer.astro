---
let year = new Date().getFullYear();
---

<footer class="footer">
    <p>&copy; {year} Fainspirit.</p>
</footer>

<style is:global>
    .footer {
        text-align: center;
        padding: var(--spacing-md) var(--spacing-xl);
        background: var(--color-highlight);
        color: white;
        font-size: 0.875rem;
        
        /* Removed position: fixed so it doesn't overlap */
        width: 100%;
    }

    .footer p {
        opacity: 0.8;
    }
</style>