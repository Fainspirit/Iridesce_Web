---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export const title = 'Games - Startail';
---

<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{`My Games - Iridesce`}</title>
    </head>
    <body>
        <Header />

        <main style="max-width:800px;margin:0 auto;padding:2rem;">
            <h1>My Games</h1>
            <p>A collection of indie games on itch.io.</p>

            <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:var(--spacing-lg);margin-top:2rem;">
                <article style="background:white;border-radius:12px;padding:var(--spacing-md);box-shadow:0 4px 6px rgba(0,0,0,0.05);">
                    <a href="https://fainspirit.itch.io/fleurish" target="_blank" rel="noopener noreferrer">
                        <span style="font-size:2rem;">🌺</span>
                        <h2>Fleurish</h2>
                        <p>Roguelike action RPG with flower upgrades.</p>
                    </a>
                </article>

                <article style="background:white;border-radius:12px;padding:var(--spacing-md);box-shadow:0 4px 6px rgba(0,0,0,0.05);">
                    <a href="https://fainspirit.itch.io/game-and-shock" target="_blank" rel="noopener noreferrer">
                        <span style="font-size:2rem;">⚡</span>
                        <h2>Game and Shock</h2>
                        <p>Arcade game defending your monument.</p>
                    </a>
                </article>

                <article style="background:white;border-radius:12px;padding:var(--spacing-md);box-shadow:0 4px 6px rgba(0,0,0,0.05);">
                    <a href="https://fainspirit.itch.io/moonlight" target="_blank" rel="noopener noreferrer">
                        <span style="font-size:2rem;">🌙</span>
                        <h2>Moonlight</h2>
                        <p>Action adventure with bad luck.</p>
                    </a>
                </article>

                <article style="background:white;border-radius:12px;padding:var(--spacing-md);box-shadow:0 4px 6px rgba(0,0,0,0.05);">
                    <a href="https://fainspirit.itch.io/rgbee" target="_blank" rel="noopener noreferrer">
                        <span style="font-size:2rem;">🎨</span>
                        <h2>RGBee</h2>
                        <p>Puzzle game turning off colors.</p>
                    </a>
                </article>
            </div>
        </main>

        <Footer />
    </body>
</html>
