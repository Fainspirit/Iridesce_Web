---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export const title = 'Gallery - Startail';
---

<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{`Art Gallery - Iridesce`}</title>
    </head>
    <body>
        <Header />

        <main style="max-width:800px;margin:0 auto;padding:2rem;">
            <h1>My Art Gallery</h1>
            <p>A collection of digital art and design work.</p>

            <div class="gallery-grid" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:var(--spacing-lg);margin-top:2rem;">
                <article style="background:white;border-radius:12px;padding:var(--spacing-md);box-shadow:0 4px 6px rgba(0,0,0,0.05);">
                    <figure style="background:#e2e8f0;height:200px;display:flex;align-items:center;justify-content:center;border-radius:8px;">
                        <span>Gallery Image</span>
                    </figure>
                </article>
                <article style="background:white;border-radius:12px;padding:var(--spacing-md);box-shadow:0 4px 6px rgba(0,0,0,0.05);">
                    <figure style="background:#e2e8f0;height:200px;display:flex;align-items:center;justify-content:center;border-radius:8px;">
                        <span>Gallery Image</span>
                    </figure>
                </article>
                <article style="background:white;border-radius:12px;padding:var(--spacing-md);box-shadow:0 4px 6px rgba(0,0,0,0.05);">
                    <figure style="background:#e2e8f0;height:200px;display:flex;align-items:center;justify-content:center;border-radius:8px;">
                        <span>Gallery Image</span>
                    </figure>
                </article>
            </div>
        </main>

        <Footer />
    </body>
</html>
