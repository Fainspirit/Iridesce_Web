---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

---

<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Iridesce ~ Blog</title>
    </head>
    <body>
        <Header />

        <main class=content>
            <h1>Blog</h1>
            <p>A bunch of stuff I like to write about :D</p>

            <article style="margin-bottom:2rem;padding:var(--spacing-xl);background:white;border-radius:12px;box-shadow:0 4px 6px rgba(0,0,0,0.05);">
                <h2><a href="/blog/post/first-post/" style="color:var(--color-primary);text-decoration:none;">Making a website with Astro</a></h2>
                <p>Woa it's a website</p>
            </article>

            <article style="margin-bottom:2rem;padding:var(--spacing-xl);background:white;border-radius:12px;box-shadow:0 4px 6px rgba(0,0,0,0.05);">
                <h2><a href="/blog/post/dev-log/" style="color:var(--color-primary);text-decoration:none;">Development Log... or is it</a></h2>
                <p>Nothin</p>
            </article>
        </main>

        <Footer />
    </body>
</html>
