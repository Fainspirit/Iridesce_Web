---
import Header from '../components/Header.astro';

export const title = 'Iridesce - Dev Blog';
---

<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{`Dev Blog - Iridesce`}</title>
    </head>
    <body>
        <Header />

        <main style="max-width:800px;margin:0 auto;padding:2rem;">
            <h1>Dev Blog</h1>
            <p>Your thoughts on game development, web technologies, and creative processes.</p>

            <article style="margin-bottom:2rem;padding:var(--spacing-xl);background:white;border-radius:12px;box-shadow:0 4px 6px rgba(0,0,0,0.05);">
                <h2><a href="/blog/post/first-post/" style="color:var(--color-primary);text-decoration:none;">Building a Game with Astro</a></h2>
                <p>Exploring how to create lightweight games using modern static site generators.</p>
            </article>

            <article style="margin-bottom:2rem;padding:var(--spacing-xl);background:white;border-radius:12px;box-shadow:0 4px 6px rgba(0,0,0,0.05);">
                <h2><a href="/blog/post/dev-log/" style="color:var(--color-primary);text-decoration:none;">Development Log: Game and Shock</a></h2>
                <p>A behind-the-scenes look at making an arcade game about defending monuments.</p>
            </article>

        </main>

        <footer class="footer">
            <p>&copy; 2026 Startail.</p>
        </footer>
    </body>
</html>
