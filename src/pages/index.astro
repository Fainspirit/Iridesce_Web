---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export const title = 'Iridesce - Startail\'s Personal Website';
---

<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{`Iridesce - Startail's Personal Website`}</title>
    </head>
    <body>
        <Header />

        <main style="max-width:700px;margin:0 auto;padding:2rem;">
            <section class="hero landing-hero">
                <h1>Hello, I'm Startail.</h1>
                <p>Creative developer making games, art, and content online.</p>

                <div class="big-buttons">
                    <a href="/about/" class="big-button">About Me</a>
                    <a href="/blog/" class="big-button">Dev Blog</a>
                    <a href="/gallery/" class="big-button">Art Gallery</a>
                    <a href="/games/" class="big-button">My Games</a>
                </div>
            </section>
        </main>

        <Footer />
    </body>
</html>
