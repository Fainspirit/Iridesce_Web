---
import Header from '../../components/Header.astro';
import '../styles/main.css';

const title = "Building a Game with Astro";
const date = new Date().toLocaleDateString('en-US', {year: 'numeric', month: 'long', day: 'numeric'});
---

<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{`{title} - Iridesce`}</title>
    </head>
    <body>
        <Header />

        <main class="blog-post">
            <article class="post-container">
                <header class="post-header">
                    <h1>{`{title}`}</h1>
                    <time datetime={date}>Written on {date}</time>
                </header>

                <div class="post-body">
                    <p>Explore how to build lightweight games using Astro and modern static site generators...</p>

                    <h2>Why Astro?</h2>
                    <p>Astro creates instant web pages with zero JavaScript by default, making it perfect for:</p>
                    <ul>
                        <li>Fermer games</li>
                        <li>Lightweight documentation</li>
                        <li>Fast-loading galleries</li>
                    </ul>

                    <h2>Getting Started</h2>
                    <p>Create an Astro project with `npx create-astro-app` and customize your first game's landing page.</p>

                    <hr style="margin: 2rem 0; border: none; border-top: 1px solid #e2e8f0;" />

                    <p>{`Enjoy reading about {title}!`}
                </div>
            </article>
        </main>
    </body>
</html>
